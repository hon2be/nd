  "description": "Minimal CDP-based Node.js debugger CLI — works with tsx, esbuild, and any source-mapped Node app",
  "type": "module",
  "bin": {
    "nd": "./bin/nd"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "debugger",
    "node",
    "cdp",
    "chrome-devtools-protocol",
    "typescript",
    "tsx",
    "source-map",
    "breakpoint",
    "cli"
  ],
  "author": "hon2be <saysun34@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hon2be/nd.git"
  },
  "homepage": "https://github.com/hon2be/nd#readme",
  "bugs": {
    "url": "https://github.com/hon2be/nd/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
